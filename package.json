{
  "name": "voxel-realms-rpg",
  "private": true,
  "version": "1.5.0",
  "description": "3D Open-World Voxel MMORPG, Castle Warfare Strategy, Single-Instance 20Hz WebSocket Siege Server & Anti-Cheat Authority (Simulated Regional Topology + Cloud SQL/Firestore), Four-Path Immortal Cultivation, 6-Tier Cosmic Hierarchy (COSMIC_LIMITS: 1 White Page -> 100 Overvoids -> Infinity Realities), D3 Cosmological Tree, Auto-Populating Open-World Lore Codex, 12 Dynastic Annals & 10^100-Word Akashic Stream built with React 19, Three.js 0.187, three-mesh-bvh, cannon-es, simplex-noise, D3.js, TypeScript, and C++20 SIMD guardrails (20/11/2026).",
  "author": "Voxel Realms RPG Team <creatergame31@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/game/*.test.ts src/lib/*.test.ts src/db/*.test.ts src/server/*.test.ts firestore.rules.test.ts",
    "test:rules": "tsx --test firestore.rules.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/game/*.test.ts src/lib/*.test.ts src/db/*.test.ts src/server/*.test.ts firestore.rules.test.ts",
    "lockfile:regenerate": "node scripts/regenerate-lockfile.mjs",
    "lockfile:verify": "node scripts/regenerate-lockfile.mjs --verify",
    "verify:ops": "tsx scripts/verify-readiness.ts",
    "verify:e2e": "bash scripts/verify-e2e-browser.sh",
    "release:package": "node scripts/package-release.mjs",
    "validate": "npm run lockfile:verify && npm run lint && npm run lint:rules && npm run format:check && npm test && npm run build"
  },
