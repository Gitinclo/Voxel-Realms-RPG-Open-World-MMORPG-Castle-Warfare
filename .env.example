# Server and Runtime Configuration
# The port where the local development server or Express proxy listens
PORT=3000

# Environment mode: development | production | test
NODE_ENV=development

# GEMINI_API_KEY: Required for optional Gemini AI API features and NPC generation.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or local .env file.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The base URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, asset loading, and API endpoints.
APP_URL="http://localhost:3000"

# Server-Side Session & Operator RBAC Security (server.ts / src/game/serverAuth.ts)
# VOXEL_SESSION_SECRET: MANDATORY CSPRNG secret for HMAC-SHA256 HttpOnly session cookies
# (>= 32 chars in production, >= 16 chars in development; server fails closed on startup if missing or placeholder).
VOXEL_SESSION_SECRET="replace-with-at-least-32-char-csprng-secret"

# VOXEL_ADMIN_PASSKEY: MANDATORY server-side operator passkey for POST /api/auth/admin-login (>= 12 chars).
# Server fails closed on startup if missing, < 12 chars, or left as placeholder.
VOXEL_ADMIN_PASSKEY="replace-with-strong-operator-passkey"

# VOXEL_ALLOW_PRODUCTION_GODMODE: Explicitly disabled ("false") in NODE_ENV=production unless
# support-only elevation is intentionally enabled for an isolated staging/debug instance.
VOXEL_ALLOW_PRODUCTION_GODMODE="false"

# Operational Storage, Preview, Base Path & Rate-Limit Tuning (server.ts / vite.config.ts)
# VOXEL_DATA_DIR: Directory for atomic online_realm_state.json + .bak failover saves (defaults to ./data)
VOXEL_DATA_DIR="./data"
# VOXEL_API_WRITE_LIMIT_PER_MIN: Per-IP write limit window for API mutations (default 120)
VOXEL_API_WRITE_LIMIT_PER_MIN="120"
# VOXEL_TRUST_PROXY: Express reverse-proxy trust setting ('loopback' default | 'false' | hop count | comma-separated CIDRs)
VOXEL_TRUST_PROXY="loopback"
# DISABLE_HMR: Disables Vite HMR file watching/websockets when "true"
DISABLE_HMR="true"
# ALLOW_PREVIEW_IFRAME: Set "true" when hosting production builds inside embedded preview iframes
ALLOW_PREVIEW_IFRAME="false"
# VITE_BASE_PATH: Public base URL path for Vite builds (defaults to "/"; GitHub Pages uses "/<repo>/", offline zip uses "./")
VITE_BASE_PATH="/"
# Optional fallback port variables read by server.ts when PORT is unset:
# VOXEL_DEV_PORT="3000"
# DEFAULT_APP_PORT="3000"

# Authoritative Economy Persistence & Multi-Instance Session Revocation
# VOXEL_ECONOMY_BACKEND: 'disk' (atomic SHA-256 single-instance default) | 'postgres' (PostgreSQL ACID SELECT FOR UPDATE transactions via economy_accounts & economy_ledger_entries)
VOXEL_ECONOMY_BACKEND="disk"
# Optional Redis REST coordination adapter (e.g., Upstash / self-hosted Redis REST proxy) for shared server-side session revocation across replicas:
# REDIS_REST_URL="https://replace-with-redis-rest-endpoint"
# REDIS_REST_TOKEN="replace-with-redis-rest-bearer-token"

# Cloud SQL (PostgreSQL) Connection Variables (src/db/index.ts & src/db/drizzle.config.ts)
# Populated automatically in provisioned AI Studio Cloud Run runtimes.
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="replace-with-sql-password"
SQL_DB_NAME="voxel_realms_db"
# Admin credentials used only when running Drizzle Kit schema migrations:
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="replace-with-admin-sql-password"
