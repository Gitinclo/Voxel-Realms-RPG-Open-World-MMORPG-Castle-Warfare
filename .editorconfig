# EditorConfig helps maintain consistent coding styles across IDEs and editors.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,hpp,h,cc}]
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,Justfile,Makefile}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
